{
  "name": "adiguneplanai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @adiguneplanai/web",
    "build": "npm run build --workspace @adiguneplanai/web",
    "typecheck": "tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/tooling/*.test.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run licenses && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
